# Store credentials here locally. Never commit this file after adding secrets.
RIVER_API_KEY=
RIVER_BASE_MODEL=Qwen/Qwen3.5-9B
# Optional token required for every API write when set (use for non-loopback access).
REFLEX_INGEST_TOKEN=
REFLEX_DB_PATH=data/reflex.sqlite3
# Each step trains one minibatch; a run must cover every eligible example.
RIVER_TRAIN_MAX_STEPS=16
RIVER_TRAIN_BATCH_SIZE=2
RIVER_RL_MAX_STEPS=1
RIVER_RL_GROUP_SIZE=2
